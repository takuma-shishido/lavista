{
  "name": "lavista",
  "version": "0.1.0",
  "private": true,
  "description": "Claude executes. Astra reviews. A fresh session takes the next step.",
  "type": "module",
  "bin": {
    "lavista": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/write-file-atomic": "^4.0.3",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.6.5"
  }
}
